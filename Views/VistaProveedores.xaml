<UserControl x:Class="NeptunoApp.Views.VistaProveedores" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="920">
<Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Padding="8" BorderBrush="#A0A0A0" BorderThickness="1" Margin="0,0,0,8"><WrapPanel><TextBlock Text="Busqueda x Nombre y Ciudad:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold"/><TextBlock Text="Nombre de contacto" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="170" Margin="0,0,10,0" Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Ciudad" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="140" Margin="0,0,10,0" Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Buscar" Padding="14,5" Command="{Binding BuscarCommand}"/><TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#2E7D32"/></WrapPanel></Border>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Nuevo" Padding="12,6" Margin="0,0,8,0" Command="{Binding NuevoCommand}"/><Button Content="Guardar" Padding="12,6" Margin="0,0,8,0" Command="{Binding GuardarCommand}"/><Button Content="Eliminar" Padding="12,6" Margin="0,0,8,0" Command="{Binding EliminarCommand}"/><Button Content="Cancelar" Padding="12,6" Command="{Binding CancelarCommand}"/></StackPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Seleccionado}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="GhostWhite" RowHeight="24" BorderBrush="#A0A0A0"><DataGrid.Columns><DataGridTextColumn Header="Codigo" Binding="{Binding ProveedorID}" Width="60"/><DataGridTextColumn Header="Compania" Binding="{Binding CompaniaNombre}" Width="150"/><DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="130"/><DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="90"/><DataGridTextColumn Header="Pais" Binding="{Binding Pais}" Width="80"/><DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="110"/></DataGrid.Columns></DataGrid>
<Border Grid.Row="3" Margin="0,10,0,0" Padding="8" BorderBrush="#A0A0A0" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Grid.Column="0" Text="Compania" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="0" Grid.Column="1" Margin="4" Text="{Binding Seleccionado.CompaniaNombre, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="0" Grid.Column="2" Text="Contacto" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="0" Grid.Column="3" Margin="4" Text="{Binding Seleccionado.NombreContacto, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="Cargo" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="1" Grid.Column="1" Margin="4" Text="{Binding Seleccionado.CargoContacto, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Direccion" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="1" Grid.Column="3" Margin="4" Text="{Binding Seleccionado.Direccion, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Grid.Row="2" Grid.Column="0" Text="Ciudad" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="2" Grid.Column="1" Margin="4" Text="{Binding Seleccionado.Ciudad, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Codigo Postal" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="2" Grid.Column="3" Margin="4" Text="{Binding Seleccionado.CodigoPostal, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Grid.Row="3" Grid.Column="0" Text="Pais" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="3" Grid.Column="1" Margin="4" Text="{Binding Seleccionado.Pais, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="3" Grid.Column="2" Text="Fax" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="3" Grid.Column="3" Margin="4" Text="{Binding Seleccionado.Fax, UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Grid.Row="4" Grid.Column="0" Text="Telefono" VerticalAlignment="Center" Margin="4"/><TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="4" Text="{Binding Seleccionado.Telefono, UpdateSourceTrigger=PropertyChanged}"/>
</Grid></Border>
</Grid>
</UserControl>
