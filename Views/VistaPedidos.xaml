<UserControl x:Class="NeptunoApp.Views.VistaPedidos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1020">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Nuevo" Padding="12,6" Margin="0,0,8,0" Command="{Binding NuevoCommand}"/>
            <Button Content="Guardar Cabecera" Padding="12,6" Margin="0,0,8,0" Command="{Binding GuardarCommand}"/>
            <Button Content="Eliminar" Padding="12,6" Margin="0,0,8,0" Command="{Binding EliminarCommand}"/>
            <Button Content="Cancelar" Padding="12,6" Margin="0,0,24,0" Command="{Binding CancelarCommand}"/>
            <Button Content="Ver reporte por fechas..." Padding="12,6" Click="BtnReporte_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cliente" VerticalAlignment="Center" Margin="4"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="4" ItemsSource="{Binding Clientes}"
                      DisplayMemberPath="Empresa" SelectedValuePath="ClienteID"
                      SelectedValue="{Binding PedidoSeleccionado.ClienteID}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Empleado" VerticalAlignment="Center" Margin="4"/>
            <ComboBox Grid.Row="0" Grid.Column="3" Margin="4" ItemsSource="{Binding Empleados}"
                      DisplayMemberPath="NombreCompleto" SelectedValuePath="EmpleadoID"
                      SelectedValue="{Binding PedidoSeleccionado.EmpleadoID}"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Transportista" VerticalAlignment="Center" Margin="4"/>
            <ComboBox Grid.Row="0" Grid.Column="5" Margin="4" ItemsSource="{Binding Transportistas}"
                      DisplayMemberPath="CompaniaNombre" SelectedValuePath="TransportistaID"
                      SelectedValue="{Binding PedidoSeleccionado.TransportistaID}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha de pedido" VerticalAlignment="Center" Margin="4"/>
            <DatePicker Grid.Row="1" Grid.Column="1" Margin="4"
                        SelectedDate="{Binding PedidoSeleccionado.FechaPedido}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Fecha requerida" VerticalAlignment="Center" Margin="4"/>
            <DatePicker Grid.Row="1" Grid.Column="3" Margin="4"
                        SelectedDate="{Binding PedidoSeleccionado.FechaRequerida}"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Fecha de envio" VerticalAlignment="Center" Margin="4"/>
            <DatePicker Grid.Row="1" Grid.Column="5" Margin="4"
                        SelectedDate="{Binding PedidoSeleccionado.FechaEnvio}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Destinatario" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="4"
                     Text="{Binding PedidoSeleccionado.Destinatario, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Ciudad destino" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="2" Grid.Column="3" Margin="4"
                     Text="{Binding PedidoSeleccionado.CiudadDestino, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="2" Grid.Column="4" Text="Pais destino" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="2" Grid.Column="5" Margin="4"
                     Text="{Binding PedidoSeleccionado.PaisDestino, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Pedidos}" SelectedItem="{Binding PedidoSeleccionado}"
                  AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="GhostWhite"
                  RowHeight="24" BorderBrush="#A0A0A0" Margin="0,4,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pedido" Binding="{Binding PedidoID}" Width="60"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat=yyyy-MM-dd}" Width="95"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="*"/>
                <DataGridTextColumn Header="Empleado" Binding="{Binding NombreEmpleado}" Width="140"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding CiudadDestino}" Width="90"/>
                <DataGridTextColumn Header="Transportista" Binding="{Binding NombreTransportista}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" BorderBrush="#A0A0A0" BorderThickness="1" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <TextBlock Text="Lineas del pedido seleccionado" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,16,0"/>
                    <TextBlock Text="Producto" VerticalAlignment="Center" Margin="2"/>
                    <ComboBox Width="250" Margin="6,0,10,0" DisplayMemberPath="NombreProducto"
                              ItemsSource="{Binding Productos}" SelectedItem="{Binding ProductoSeleccionado}"/>
                    <TextBlock Text="Cant." VerticalAlignment="Center"/>
                    <TextBox Width="50" Margin="4,0,10,0" Text="{Binding CantidadLinea, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Descuento" VerticalAlignment="Center"/>
                    <TextBox Width="60" Margin="4,0,10,0" Text="{Binding DescuentoLinea, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="+" Padding="10,4" Margin="0,0,6,0" Command="{Binding AgregarLineaCommand}"/>
                    <Button Content="Quitar" Padding="10,4" Command="{Binding QuitarLineaCommand}"/>
                </WrapPanel>
                <DataGrid Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding DetalleActual}"
                          SelectedItem="{Binding DetalleSeleccionada}" AutoGenerateColumns="False"
                          IsReadOnly="True" RowHeight="22">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="70"/>
                        <DataGridTextColumn Header="Descuento" Binding="{Binding Descuento, StringFormat=0.##}" Width="80"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalLinea, StringFormat=N2}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StatusBar Grid.Row="2">
                    <StatusBarItem Content="Use Agregar linea para incorporar productos del pedido; los cambios se guardan al momento."/>
                </StatusBar>
            </Grid>
        </Border>
    </Grid>
</UserControl>

